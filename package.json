{
  "name": "leapsome-case-study",
  "version": "0.0.0",
  "engines": {
    "node": ">=18.17.1"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:service\" \"npm run dev:client\"",
    "dev:service": "nodemon --watch \"src/api/**/*.ts\" --exec \"ts-node --project tsconfig.server.json src/api/server.ts\"",
    "dev:client": "vite",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox",
    "test:headed": "playwright test --project=e2e-chromium --headed",
    "test:report": "playwright show-report",
    "test:typecheck": "tsc -p tests/tsconfig.json",
    "test:lint": "eslint tests playwright.config.ts --ext .ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:fix": "eslint --fix . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@headlessui/vue": "^1.5.0",
    "@heroicons/vue": "^1.0.6",
    "@prisma/client": "^3.15.2",
    "@vueuse/core": "^8.2.4",
    "axios": "^0.26.1",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.20.0",
    "class-transformer": "^0.3.1",
    "class-validator": "^0.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "jsonwebtoken": "^8.5.1",
    "multer": "^1.4.4",
    "nodemon": "^2.0.15",
    "pinia": "^2.0.13",
    "pino": "^7.9.2",
    "reflect-metadata": "^0.1.13",
    "routing-controllers": "^0.9.0",
    "sanitize-html": "^2.7.0",
    "vue": "^3.2.31",
    "vue-router": "^4.0.14"
  },
  "devDependencies": {
    "@faker-js/faker": "^6.1.2",
    "@playwright/test": "^1.61.1",
    "@rushstack/eslint-patch": "^1.1.0",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/line-clamp": "^0.3.1",
    "@tailwindcss/typography": "^0.5.2",
    "@types/bcrypt": "^5.0.0",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.11.26",
    "@types/sanitize-html": "^2.6.2",
    "@vitejs/plugin-vue": "^2.3.1",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^10.0.0",
    "@vue/tsconfig": "^0.1.3",
    "autoprefixer": "^10.4.4",
    "concurrently": "^7.1.0",
    "esbuild": "^0.14.30",
    "esbuild-runner": "^2.2.1",
    "eslint": "^8.5.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-typescript": "^3.0.0",
    "eslint-plugin-vue": "^8.2.0",
    "postcss": "^8.4.12",
    "prettier": "^2.5.1",
    "prisma": "^3.15.2",
    "tailwindcss": "^3.0.23",
    "ts-node": "^10.9.2",
    "typescript": "~4.6.3",
    "vite": "^2.9.1",
    "vue-tsc": "^0.33.9"
  }
}
